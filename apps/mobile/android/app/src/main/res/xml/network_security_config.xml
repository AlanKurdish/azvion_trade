<?xml version="1.0" encoding="utf-8"?>
<!--
  Enforce HTTPS for the API.
  base-config has cleartextTrafficPermitted="false", so any plain http://
  request anywhere in the app will be blocked at the OS level.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow plain http ONLY to the local dev backend reached from the Android
         emulator (10.0.2.2 = host loopback). Harmless in release since no real
         device/server uses these hosts; production traffic to azne-app.com stays
         https via base-config. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
